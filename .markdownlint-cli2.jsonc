{
  // Curated inputs are passed by scripts/docs/lint_docs.py; no generated site or dependencies.
  "config": {
    "default": true,
    // Prose paragraphs are deliberately unwrapped; renderers handle line wrapping.
    "MD013": false,
    // Allow existing public image markup; prefer Markdown in authored guides.
    "MD033": { "allowed_elements": ["div", "pre", "p", "img"] },
    // Compact delimiter rows are shared by authored and renderer-owned tables.
    "MD060": false
  },
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "config": {
        // Repository instructions use compact fenced examples and lists.
        "MD031": false,
        "MD032": false
      },
      "combine": "merge"
    },
    {
      "filter": [".github/pull_request_template.md"],
      "config": {
        // A PR template is inserted into an existing form; it has no document title.
        "MD041": false
      },
      "combine": "merge"
    },
    {
      "filter": ["README.md"],
      "config": {
        // The README intentionally uses HTML for its title, badges, centered links,
        // and renderer-owned preview layout; authored guides use Markdown.
        "MD033": { "allowed_elements": ["div", "pre", "p", "img", "h1", "a", "strong", "br"] }
      },
      "combine": "merge"
    }
  ]
}
