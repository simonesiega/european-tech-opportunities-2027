{
  // Curated inputs are passed by scripts/lint_docs.py; no generated site or dependencies.
  "config": {
    "default": true,
    // Paragraphs are deliberately unwrapped. Even a 400-character limit with
    // code, headings, and tables exempt still reports over 70 prose lines.
    "MD013": false,
    // Centered diagrams and image layouts in the guides use these HTML tags.
    "MD033": { "allowed_elements": ["div", "pre", "p", "img"] },
    // Existing tables mix compact delimiter rows and variable-width columns;
    // MD060 reports 258 formatting-only issues, including renderer-owned tables.
    "MD060": false
  },
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "config": {
        // Repository instructions use compact fenced examples and lists.
        "MD031": false,
        "MD032": false
      },
      "combine": "merge"
    },
    {
      "filter": [".github/pull_request_template.md"],
      "config": {
        // A PR template is inserted into an existing form; it has no document title.
        "MD041": false
      },
      "combine": "merge"
    },
    {
      "filter": ["docs/guides/operations/database.md"],
      "config": {
        // The recovery instructions continue numbering across separated sections.
        "MD029": false
      },
      "combine": "merge"
    },
    {
      "filter": ["README.md"],
      "config": {
        // The public README starts with an HTML h1, followed by Markdown h2s.
        "MD001": false,
        "MD041": false,
        // Badges, centered links, and the HTML title are intentional here only.
        "MD033": { "allowed_elements": ["div", "pre", "p", "img", "h1", "a", "strong", "br"] }
      },
      "combine": "merge"
    }
  ]
}
